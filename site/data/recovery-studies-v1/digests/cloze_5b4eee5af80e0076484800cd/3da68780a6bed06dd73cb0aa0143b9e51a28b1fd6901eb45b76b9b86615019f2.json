ce_labels_used":["S1","S2"],"status":"PASS_BOUNDED_SOURCE_AND_CITATION_REVIEW","version":"API0-study-digest-source-review/1","word_count":87,"world_truth_certified":false},"source_input_ref":{"bytes":27502,"path":"data/recovery-studies-v1/digest-inputs/cloze_5b4eee5af80e0076484800cd/df6a3fd3769f40b84378a751eb4dfc6bb891cdc308a80667abf7b43853e88ea5.json","sha256":"df6a3fd3769f40b84378a751eb4dfc6bb891cdc308a80667abf7b43853e88ea5"},"source_map":[{"canonical_page_id":"page_61d3bb2410fd353688c4","citations":[{"citation":{"canonical_page_id":"page_61d3bb2410fd353688c4","corpus":"cib","date":"1958-10-20","document_id":"CIA-RDP79T00975A004000330001-0","earlier_page":6,"end":772,"page_sha256":"64428316bb1275cb17654085487e60506e870115e79d5ba7d7205bfc1f285f95","start":618,"text":"Istiqlal extremists are particularly critical of the cabinet's lack of control over the army and security forces, which are under the King's jurisdiction."},"id":"C1"},{"citation":{"canonical_page_id":"page_61d3bb2410fd353688c4","corpus":"cib","date":"1958-10-20","document_id":"CIA-RDP79T00975A004000330001-0","earlier_page":6,"end":771,"page_sha256":"64428316bb1275cb17654085487e60506e870115e79d5ba7d7205bfc1f285f95","start":742,"text":"under the King's jurisdiction"},"id":"C2"},{"citation":{"canonical_page_id":"page_61d3bb2410fd353688c4","corpus":"cib","date":"1958-10-20","document_id":"CIA-RDP79T00975A004000330001-0","earlier_page":6,"end":1146,"page_sha256":"64428316bb1275cb17654085487e60506e870115e79d5ba7d7205bfc1f285f95","start":618,"text":"Istiqlal extremists are particularly critical of the cabinet's lack of control over the army and security forces, which are under the King's jurisdiction. Their request for a change in this control was rejected by the King recently after the issue was highlighted by the anti-Istiqlal activities of a rival party in the Rif mountain area. Istiqlal leaders consider that the director of national security was slow in acting against this party's terrorism. They also accuse him of playing off one Istiqlal faction against another."},"id":"C3"}],"corpus":"cib","date":"1958-10-20","document_id":"CIA-RDP79T00975A004000330001-0","earlier_page":6,"id":"S1","page_sha256":"64428316bb1275cb17654085487e60506e870115e79d5ba7d7205bfc1f285f95"},{"canonical_page_id":"page_955c03aa12215fbe7b42","citations":[{"citation":{"canonical_page_id":"page_955c03aa12215fbe7b42","corpus":"cib","date":"1958-08-19","document_id":"CIA-RDP79T00975A003900150001-2","earlier_page":6,"end":1522,"page_sha256":"4cd0fd810ee311707f42b45ec03f97319e08837c6f6272659f8a5d3275e35c88","start":1342,"text":"The position of Balafrej, and to a lesser extent that of the King, remains tenuous because of left-wing Istiqlal and labor union criticism of the predominantly moderate government."},"id":"C1"},{"citation":{"canonical_page_id":"page_955c03aa12215fbe7b42","corpus":"cib","date":"1958-08-19","document_id":"CIA-RDP79T00975A003900150001-2","earlier_page":6,"end":1424,"page_sha256":"4cd0fd810ee311707f42b45ec03f97319e08837c6f6272659f8a5d3275e35c88","start":1417,"text":"tenuous"},"id":"C2"},{"citation":{"canonical_page_id":"page_955c03aa12215fbe7b42","corpus":"cib","date":"1958-08-19","document_id":"CIA-RDP79T00975A003900150001-2","earlier_page":6,"end":1680,"page_sha256":"4cd0fd810ee311707f42b45ec03f97319e08837c6f6272659f8a5d3275e35c88","start":1342,"text":"The position of Balafrej, and to a lesser extent that of the King, remains tenuous because of left-wing Istiqlal and labor union criticism of the predominantly moderate government. Belief is widespread throughout Morocco that the American bases were used to support the landings in Lebanon and that atomic weapons are stored at the bases."},"id":"C3"}],"corpus":"cib","date":"1958-08-19","document_id":"CIA-RDP79T00975A003900150001-2","earlier_page":6,"id":"S2","page_sha256":"4cd0fd810ee311707f42b45ec03f97319e08837c6f6272659f8a5d3275e35c88"}],"text":"\u201cControlling\u201d is the leading contextual suggestion: the 20 October report says Morocco\u2019s army and security forces were under the King\u2019s jurisdiction, that Istiqlal extremists criticized the cabinet\u2019s lack of control, and that the King recently rejected their request to change this arrangement [S1]. This supports the characterization, not a literal recovery of the concealed wording. The alternative \u201ctenuous\u201d comes from an August report describing Balafrej\u2019s position, and the King\u2019s to a lesser extent; it does not connect royal vulnerability to the particular discontent in the passage [S2].","text_sha256":"6416489129bc327e64bae9695980d37073cd7e057942f738e3cfc7c86720a636","text_utf8_sha256":"1f145fd636d117b7bdf7ee9a13d46a39639e47a7481a5cc322b21e650d2cb3ae","used_for_inference":false,"version":"recovery-study-postrun-digest-overlay/1"}