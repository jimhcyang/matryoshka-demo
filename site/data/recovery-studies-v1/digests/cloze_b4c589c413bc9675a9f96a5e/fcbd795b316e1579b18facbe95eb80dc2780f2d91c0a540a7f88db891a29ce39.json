_labels_used":["S1","S2"],"status":"PASS_BOUNDED_SOURCE_AND_CITATION_REVIEW","version":"API0-study-digest-source-review/1","word_count":79,"world_truth_certified":false},"source_input_ref":{"bytes":27183,"path":"data/recovery-studies-v1/digest-inputs/cloze_b4c589c413bc9675a9f96a5e/bff15e8492ab4741dc8771c3a46811bdc38c8d4d5c44fe6f91b5ce57b0bdfa25.json","sha256":"bff15e8492ab4741dc8771c3a46811bdc38c8d4d5c44fe6f91b5ce57b0bdfa25"},"source_map":[{"canonical_page_id":"page_c2a62bfd5525ce17d11c","citations":[{"citation":{"canonical_page_id":"page_c2a62bfd5525ce17d11c","corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":7,"end":1240,"page_sha256":"da1185e432323fb5f63ea794d159f0c00ac3bd3292e6ed70ee9578ec937f7ee7","start":1134,"text":"Yuriy Zhukov, Soviet cultural relations leader, confirmed the general line taken by Khrushchev and Gromyko"},"id":"C1"},{"citation":{"canonical_page_id":"page_c2a62bfd5525ce17d11c","corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":7,"end":1240,"page_sha256":"da1185e432323fb5f63ea794d159f0c00ac3bd3292e6ed70ee9578ec937f7ee7","start":1218,"text":"Khrushchev and Gromyko"},"id":"C2"}],"corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":7,"id":"S1","page_sha256":"da1185e432323fb5f63ea794d159f0c00ac3bd3292e6ed70ee9578ec937f7ee7"},{"canonical_page_id":"page_b6f9818d530e529b4aa5","citations":[{"citation":{"canonical_page_id":"page_b6f9818d530e529b4aa5","corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":3,"end":763,"page_sha256":"5b1c05ff45d6ceb7177d992bcbcc8689b39128d547e84aaa370096e7dc47054c","start":639,"text":"Khrushchev, Gromyko, and Zhukov all seemed to assume that negotiations on disarmament and a nuclear test ban would continue."},"id":"C1"},{"citation":{"canonical_page_id":"page_b6f9818d530e529b4aa5","corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":3,"end":670,"page_sha256":"5b1c05ff45d6ceb7177d992bcbcc8689b39128d547e84aaa370096e7dc47054c","start":639,"text":"Khrushchev, Gromyko, and Zhukov"},"id":"C2"},{"citation":{"canonical_page_id":"page_b6f9818d530e529b4aa5","corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":3,"end":1025,"page_sha256":"5b1c05ff45d6ceb7177d992bcbcc8689b39128d547e84aaa370096e7dc47054c","start":535,"text":"*This point was echoed by Yuriy Zhukov, chairman of the State Committee for Foreign Cultural Relations. Khrushchev, Gromyko, and Zhukov all seemed to assume that negotiations on disarmament and a nuclear test ban would continue. Zhukov indicated that Khrushchev had played \"this one by ear,\" that even those in his own retinue did not know what he might do from one minute to the next, and that a central committee meeting and a subsequent bloc conference were virtual certainties. (Page 1)"},"id":"C3"}],"corpus":"cib","date":"1960-05-19","document_id":"CIA-RDP79T00975A005100160001-7","earlier_page":3,"id":"S2","page_sha256":"5b1c05ff45d6ceb7177d992bcbcc8689b39128d547e84aaa370096e7dc47054c"}],"text":"The leading suggestion, \u201cKhrushchev and Gromyko,\u201d draws on a report saying that Yuriy Zhukov confirmed their general line; that passage does not itself connect the pair to the concealed statement about negotiations [S1]. The alternative, \u201cKhrushchev, Gromyko, and Zhukov,\u201d appears in the same-day brief, which says all three \u201cseemed to assume\u201d that disarmament and nuclear test-ban negotiations would continue [S2]. This supports an apparent expectation of continued talks, not a completed agreement, while leaving the precise concealed wording unresolved.","text_sha256":"f735849a0c1f7a1505e5ba1b1445bc5c55eb400333c16cb0b025549c0be41037","text_utf8_sha256":"4eeea0eff70c871d695c025e760fc859a1e5b432663c0483101c0135ebe16c90","used_for_inference":false,"version":"recovery-study-postrun-digest-overlay/1"}