"cache_reuse":false,"call_id_sha256":"4fe2fde8b99f00d0992412fc7a0f46c8e9ca74d24166fd80b757c98152006dac","exact_cache_stored_bytes_sha256":"bb031f100272119200880e135ea43ff477f6c756f30e97e7560687661f08c30a","execution_contract":"phase-exact-api/2","finished_utc":"2026-11-27T22:14:00.397914+00:00","model":"gpt-6.1-sol","model_sha256":"2da8faee9a3ed7401be88eab08f9f50de122763b54cdce94dced4c0d06e0ee4f","original_private_provenance_retained":true,"private_locations_exported":false,"provider_response_id_sha256":"ca050d966df80deac95e8248c4946642d372e57f4eabf31d56e2218d515af060","receipt_stored_bytes_sha256":"1ccf402fa4a1dc7e29e795bd37a63d07da298550f9cca30da834fce23523ffca","request_stored_bytes_sha256":"12ab826a3c34e995a2972f27579953b08cc139ac32f981225fa77e2e20eaa886","response_canonical_sha256":"c5e2825ec073f7759c18171b35d11d974eaaec3198ce70f69dccaf2f7584e19f","response_stored_bytes_sha256":"d3d5f07efce457921e388bd06cd82cfeb8922361d176dc20e089cf3e069c6a67","started_utc":"2026-11-27T22:13:56.974118+00:00","usage":{"input_tokens":15163,"input_tokens_details":{"cache_write_tokens":15160,"cache_write_tokens_details":{"ttl_12h_tokens":0,"ttl_30m_tokens":15160},"cached_tokens":0},"output_tokens":133,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":15296},"version":"actual-study-postrun-digest-hash-provenance/1"},"review":{"actual_provider_request_response_receipt_replayed":true,"all_supplied_source_citations_replayed":true,"digest_utf8_sha256":"3298b75fa3be5d12a024e86e7ff448a05d2889b3b14637fb337946c2351fd397","note":"The June1958 apparent reduction in rivalries and January13 dissident pressure are correctly separated. Neither is promoted into the January23 compromise's concealed causal wording.","original_QA_or_hidden_equivalence_regraded":false,"reviewer_kind":"API0_ASSISTANT_SOURCE_REVIEW_NOT_HUMAN_OR_MODEL_CERTIFICATE","source_attribution_conditions_and_missing_links_preserved":true,"source_factual_support_upgraded":false,"source_labels_used":["S1","S2"],"status":"PASS_BOUNDED_SOURCE_AND_CITATION_REVIEW","version":"API0-study-digest-source-review/1","word_count":84,"world_truth_certified":false},"source_input_ref":{"bytes":51877,"path":"data/recovery-studies-v1/digest-inputs/cloze_82d3643c14a312f37ccc35da/7d3d8b7b332b17070d30ce877a9837670106357fed0cadcb0d60466c0a2989e0.json","sha256":"7d3d8b7b332b17070d30ce877a9837670106357fed0cadcb0d60466c0a2989e0"},"source_map":[{"canonical_page_id":"page_1d94109ba89d2e79d975","citations":[{"citation":{"canonical_page_id":"page_1d94109ba89d2e79d975","corpus":"cib","date":"1958-06-14","document_id":"CIA-RDP79T00975A003700390001-8","earlier_page":12,"end":1159,"page_sha256":"6e2a24ed4360553cad1f9139f988a406a47dcd020dec7666aab4232334c6b0d3","start":1022,"text":"Kishi's assertion of his leadership appears to be a significant step toward reducing factional and political rivalries in the government."},"id":"C1"},{"citation":{"canonical_page_id":"page_1d94109ba89d2e79d975","corpus":"cib","date":"1958-06-14","document_id":"CIA-RDP79T00975A003700390001-8","earlier_page":12,"end":1158,"page_sha256":"6e2a24ed4360553cad1f9139f988a406a47dcd020dec7666aab4232334c6b0d3","start":1107,"text":"factional and political rivalries in the government"},"id":"C2"},{"citation":{"canonical_page_id":"page_1d94109ba89d2e79d975","corpus":"cib","date":"1958-06-14","document_id":"CIA-RDP79T00975A003700390001-8","earlier_page":12,"end":1159,"page_sha256":"6e2a24ed4360553cad1f9139f988a406a47dcd020dec7666aab4232334c6b0d3","start":860,"text":"While the press has, as usual, expressed distrust of the new cabinet, business interests have welcomed it as likely to be one of the most stable in recent years. Kishi's assertion of his leadership appears to be a significant step toward reducing factional and political rivalries in the government."},"id":"C3"}],"corpus":"cib","date":"1958-06-14","document_id":"CIA-RDP79T00975A003700390001-8","earlier_page":12,"id":"S1","page_sha256":"6e2a24ed4360553cad1f9139f988a406a47dcd020dec7666aab4232334c6b0d3"},{"canonical_page_id":"page_e5702db1bfa1be715132","citations":[{"citation":{"canonical_page_id":"page_e5702db1bfa1be715132","corpus":"cib","date":"1959-01-13","document_id":"CIA-RDP79T00975A004200340001-7","earlier_page":7,"end":1176,"page_sha256":"7eaa148e52576a9988ceae7b800e72ecb620e7892c63fcefa6f7a222413a7587","start":919,"text":"By withholding their participation, prominent dissident leaders are maintaining pressure on Kishi to meet their demands for a complete cabinet reshuffle and for a postponement of the party presidential election until the expiration of Kishi's term in March."},"id":"C1"},{"citation":{"canonical_page_id":"page_e5702db1bfa1be715132","corpus":"cib","date":"1959-01-13","document_id":"CIA-RDP79T00975A004200340001-7","earlier_page":7,"end":1016,"page_sha256":"7eaa148e52576a9988ceae7b800e72ecb620e7892c63fcefa6f7a222413a7587","start":955,"text":"prominent dissident leaders are maintaining pressure on Kishi"},"id":"C2"},{"citation":{"canonical_page_id":"page_e5702db1bfa1be715132","corpus":"cib","date":"1959-01-13","document_id":"CIA-RDP79T00975A004200340001-7","earlier_page":7,"end":1327,"page_sha256":"7eaa148e52576a9988ceae7b800e72ecb620e7892c63fcefa6f7a222413a7587","start":838,"text":"The reshuffle points up Kishi's diminishing control of the party and government. By withholding their participation, prominent dissident leaders are maintaining pressure on Kishi to meet their demands for a complete cabinet reshuffle and for a postponement of the party presidential election until the expiration of Kishi's term in March. The postponement could give the dissidents time in which to agree on a candidate to challenge Kishi for the top party post and the prime ministership."},"id":"C3"},{"citation":{"canonical_page_id":"page_e5702db1bfa1be715132","corpus":"cib","date":"1959-01-13","document_id":"CIA-RDP79T00975A004200340001-7","earlier_page":7,"end":1038,"page_sha256":"7eaa148e52576a9988ceae7b800e72ecb620e7892c63fcefa6f7a222413a7587","start":955,"text":"prominent dissident leaders are maintaining pressure on Kishi to meet their demands"},"id":"C4"}],"corpus":"cib","date":"1959-01-13","document_id":"CIA-RDP79T00975A004200340001-7","earlier_page":7,"id":"S2","page_sha256":"7eaa148e52576a9988ceae7b800e72ecb620e7892c63fcefa6f7a222413a7587"},{"canonical_page_id":"page_b4692577ea5f178aaa74","citations":[{"citation":{"canonical_page_id":"page_b4692577ea5f178aaa74","corpus":"cib","date":"1957-07-11","document_id":"CIA-RDP79T00975A003200090001-6","earlier_page":10,"end":604,"page_sha256":"2df16fc4789e2022f27eb1c797e4fe981933e4201d316237b7811ce56aebaabe","start":297,"text":"Kishi waited more than four months, until he had gained increased prestige and political strength from trips to Southeast Asia and the United States, before undertaking cabinet changes which might otherwise have precipitated a renewal of factional struggles within the conservative Liberal-Democratic Party."},"id":"C1"},{"citation":{"canonical_page_id":"page_b4692577ea5f178aaa74","corpus":"cib","date":"1957-07-11","document_id":"CIA-RDP79T00975A003200090001-6","earlier_page":10,"end":603,"page_sha256":"2df16fc4789e2022f27eb1c797e4fe981933e4201d316237b7811ce56aebaabe","start":535,"text":"factional struggles within the conservative Liberal-Democratic Party"},"id":"C2"},{"citation":{"canonical_page_id":"page_b4692577ea5f178aaa74","corpus":"cib","date":"1957-07-11","document_id":"CIA-RDP79T00975A003200090001-6","earlier_page":10,"end":773,"page_sha256":"2df16fc4789e2022f27eb1c797e4fe981933e4201d316237b7811ce56aebaabe","start":297,"text":"Kishi waited more than four months, until he had gained increased prestige and political strength from trips to Southeast Asia and the United States, before undertaking cabinet changes which might otherwise have precipitated a renewal of factional struggles within the conservative Liberal-Democratic Party. Kishi also changed officials in the top posts of the party and probably has consolidated his position. Some factional leaders, however, may not be completely satisfied."},"id":"C3"}],"corpus":"cib","date":"1957-07-11","document_id":"CIA-RDP79T00975A003200090001-6","earlier_page":10,"id":"S3","page_sha256":"2df16fc4789e2022f27eb1c797e4fe981933e4201d316237b7811ce56aebaabe"},{"canonical_page_id":"page_c7eb636719b5f7e8e928","citations":[{"citation":{"canonical_page_id":"page_c7eb636719b5f7e8e928","corpus":"cib","date":"1957-02-19","document_id":"CIA-RDP79T00975A002900550001-9","earlier_page":10,"end":800,"page_sha256":"6d222074a0e08e4854ce96aa1467a94fb982ebe783e46e281c15539e57481a9c","start":517,"text":"Should Ishibashi remain incapacitated, the necessity of providing effective substitute leadership and of quelling intraparty discord suggests that Foreign Minister Kishi might be appointed deputy prime minister, thereby making him a logical choice to succeed Ishibashi in the future."},"id":"C1"},{"citation":{"canonical_page_id":"page_c7eb636719b5f7e8e928","corpus":"cib","date":"1957-02-19","document_id":"CIA-RDP79T00975A002900550001-9","earlier_page":10,"end":649,"page_sha256":"6d222074a0e08e4854ce96aa1467a94fb982ebe783e46e281c15539e57481a9c","start":631,"text":"intraparty discord"},"id":"C2"}],"corpus":"cib","date":"1957-02-19","document_id":"CIA-RDP79T00975A002900550001-9","earlier_page":10,"id":"S4","page_sha256":"6d222074a0e08e4854ce96aa1467a94fb982ebe783e46e281c15539e57481a9c"}],"text":"The leading suggestion, \u201cfactional and political rivalries in the government,\u201d comes from a June 1958 report judging that Kishi\u2019s assertion of leadership appeared to be a significant step toward reducing those rivalries [S1]. The January 13, 1959 report supplies the more immediate context: dissident leaders were withholding participation to press for a complete cabinet reshuffle and postponement of the party election until March [S2]. These accounts illuminate the rivalry surrounding Kishi, but neither connects its wording directly to the January 23 compromise\u2019s temporary respite.","text_sha256":"4cddd64860a88b6899615db5cbeb8357266f06ea0409fd3d2b41fe0392882b9a","text_utf8_sha256":"3298b75fa3be5d12a024e86e7ff448a05d2889b3b14637fb337946c2351fd397","used_for_inference":false,"version":"recovery-study-postrun-digest-overlay/1"}