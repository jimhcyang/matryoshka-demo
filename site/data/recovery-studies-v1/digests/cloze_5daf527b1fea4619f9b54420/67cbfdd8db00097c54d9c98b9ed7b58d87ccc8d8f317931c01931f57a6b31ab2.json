"S1"],"status":"PASS_BOUNDED_SOURCE_AND_CITATION_REVIEW","version":"API0-study-digest-source-review/1","word_count":76,"world_truth_certified":false},"source_input_ref":{"bytes":50881,"path":"data/recovery-studies-v1/digest-inputs/cloze_5daf527b1fea4619f9b54420/5714f0cfe9b9609d0932698cd0759ad94f69f801aa1c9d184d15ec134808865f.json","sha256":"5714f0cfe9b9609d0932698cd0759ad94f69f801aa1c9d184d15ec134808865f"},"source_map":[{"canonical_page_id":"page_fdf833dea9499ff0fa94","citations":[{"citation":{"canonical_page_id":"page_fdf833dea9499ff0fa94","corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"end":654,"page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff","start":439,"text":"Gamal Salim, former deputy prime minister whose brother Salah Salim was forced to resign last year, and ex-minister of state Anwar Sadat have been noted for their extremely nationalistic and anti-Western manifestos."},"id":"C1"},{"citation":{"canonical_page_id":"page_fdf833dea9499ff0fa94","corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"end":642,"page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff","start":602,"text":"extremely nationalistic and anti-Western"},"id":"C2"},{"citation":{"canonical_page_id":"page_fdf833dea9499ff0fa94","corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"end":827,"page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff","start":439,"text":"Gamal Salim, former deputy prime minister whose brother Salah Salim was forced to resign last year, and ex-minister of state Anwar Sadat have been noted for their extremely nationalistic and anti-Western manifestos. Hassan Ibrahim, the third RCC member dropped, reportedly was among those who strongly opposed Salah Salim's resignation. Little is known of the two new civilian appointees."},"id":"C3"},{"citation":{"canonical_page_id":"page_fdf833dea9499ff0fa94","corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"end":775,"page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff","start":655,"text":"Hassan Ibrahim, the third RCC member dropped, reportedly was among those who strongly opposed Salah Salim's resignation."},"id":"C4"},{"citation":{"canonical_page_id":"page_fdf833dea9499ff0fa94","corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"end":680,"page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff","start":675,"text":"third"},"id":"C5"}],"corpus":"cib","date":"1956-07-01","document_id":"CIA-RDP79T00975A002600290001-1","earlier_page":7,"id":"S1","page_sha256":"5c1515899268a56f99721f37ac0473ff72e56aa15c739c452b4146f0bb1200ff"},{"canonical_page_id":"page_1340679d0e54b5555bb4","citations":[{"citation":{"canonical_page_id":"page_1340679d0e54b5555bb4","corpus":"cib","date":"1953-05-21","document_id":"CIA-RDP79T00975A001100460001-8","earlier_page":8,"end":462,"page_sha256":"460a93bccfcc4a4186ee7ea2186793574a9ab9e8adee206e324b727b22fad108","start":308,"text":"There is also wide dissatisfaction among the middle classes with the leadership of the young, inexperienced officers of the Revolutionary Command Council."},"id":"C1"},{"citation":{"canonical_page_id":"page_1340679d0e54b5555bb4","corpus":"cib","date":"1953-05-21","document_id":"CIA-RDP79T00975A001100460001-8","earlier_page":8,"end":415,"page_sha256":"460a93bccfcc4a4186ee7ea2186793574a9ab9e8adee206e324b727b22fad108","start":395,"text":"young, inexperienced"},"id":"C2"}],"corpus":"cib","date":"1953-05-21","document_id":"CIA-RDP79T00975A001100460001-8","earlier_page":8,"id":"S2","page_sha256":"460a93bccfcc4a4186ee7ea2186793574a9ab9e8adee206e324b727b22fad108"},{"canonical_page_id":"page_1f26b192620b540597bc","citations":[{"citation":{"canonical_page_id":"page_1f26b192620b540597bc","corpus":"cib","date":"1952-12-25","document_id":"CIA-RDP79T00975A000900630001-2","earlier_page":6,"end":909,"page_sha256":"3c84f765663ea0f011f874883d38262d45bedd2c97ed648e7b15bb76e98695df","start":727,"text":"A return to the popular theme of \"national struggle\" might gain the support of extreme nationalist elements within Egypt and distract attention from the increasing internal problems."},"id":"C1"},{"citation":{"canonical_page_id":"page_1f26b192620b540597bc","corpus":"cib","date":"1952-12-25","document_id":"CIA-RDP79T00975A000900630001-2","earlier_page":6,"end":825,"page_sha256":"3c84f765663ea0f011f874883d38262d45bedd2c97ed648e7b15bb76e98695df","start":806,"text":"extreme nationalist"},"id":"C2"},{"citation":{"canonical_page_id":"page_1f26b192620b540597bc","corpus":"cib","date":"1952-12-25","document_id":"CIA-RDP79T00975A000900630001-2","earlier_page":6,"end":1001,"page_sha256":"3c84f765663ea0f011f874883d38262d45bedd2c97ed648e7b15bb76e98695df","start":727,"text":"A return to the popular theme of \"national struggle\" might gain the support of extreme nationalist elements within Egypt and distract attention from the increasing internal problems. There is no firm indication, however, that a drastic change in Egyptian policy is imminent."},"id":"C3"}],"corpus":"cib","date":"1952-12-25","document_id":"CIA-RDP79T00975A000900630001-2","earlier_page":6,"id":"S3","page_sha256":"3c84f765663ea0f011f874883d38262d45bedd2c97ed648e7b15bb76e98695df"},{"canonical_page_id":"page_2a9dd9d2a8c3c29a9062","citations":[{"citation":{"canonical_page_id":"page_2a9dd9d2a8c3c29a9062","corpus":"cib","date":"1955-08-30","document_id":"CIA-RDP79T00975A002100590001-2","earlier_page":7,"end":441,"page_sha256":"177bd5adf5020b35dc4ea9491dd01245f8f4384e465a8343baf58e3e1d90b052","start":309,"text":"Salim has long been reputed to be Prime Minister Nasr's principal opponent and leader of an extreme anti-Western faction in the RCC."},"id":"C1"},{"citation":{"canonical_page_id":"page_2a9dd9d2a8c3c29a9062","corpus":"cib","date":"1955-08-30","document_id":"CIA-RDP79T00975A002100590001-2","earlier_page":7,"end":421,"page_sha256":"177bd5adf5020b35dc4ea9491dd01245f8f4384e465a8343baf58e3e1d90b052","start":401,"text":"extreme anti-Western"},"id":"C2"},{"citation":{"canonical_page_id":"page_2a9dd9d2a8c3c29a9062","corpus":"cib","date":"1955-08-30","document_id":"CIA-RDP79T00975A002100590001-2","earlier_page":7,"end":694,"page_sha256":"177bd5adf5020b35dc4ea9491dd01245f8f4384e465a8343baf58e3e1d90b052","start":309,"text":"Salim has long been reputed to be Prime Minister Nasr's principal opponent and leader of an extreme anti-Western faction in the RCC. Although the apparent failure of Salim's campaign to unite the Sudan with Egypt is cited in the press as the reason for his eclipse at this time, there have been numerous reports that Nasr intended to oust Salim whenever he felt strong enough to do so."},"id":"C3"}],"corpus":"cib","date":"1955-08-30","document_id":"CIA-RDP79T00975A002100590001-2","earlier_page":7,"id":"S4","page_sha256":"177bd5adf5020b35dc4ea9491dd01245f8f4384e465a8343baf58e3e1d90b052"}],"text":"The leading suggestion, \u201cextremely nationalistic and anti-Western,\u201d draws on the report\u2019s description of Gamal Salim\u2019s and Anwar Sadat\u2019s manifestos, not an explicit characterization of every RCC member removed [S1]. The report identifies Hassan Ibrahim as the third member dropped and says he reportedly strongly opposed Salah Salim\u2019s resignation [S1]. This makes the ideological phrase a contextual suggestion rather than recovered wording: the missing connection is whether that description applied to the removed group as a whole.","text_sha256":"cc1540a95ee3309ed35e30a646ec73eddd9aac2187c6ef9a9a40fa27d0d4e563","text_utf8_sha256":"a285b82ac03165d3e24364a09dab38ef861423f0e5e0b02153e6119769882bc9","used_for_inference":false,"version":"recovery-study-postrun-digest-overlay/1"}