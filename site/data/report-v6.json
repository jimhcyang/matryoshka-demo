publication_date":"1960-12-29","start":1449,"text":"The military is split by dissension, however, and has given no recent indication that it is about to unite to stem the Communist bid for power."}}],"view":"earlier"}},"privacy_contract":{"require_story_attempts_before_privileged_sources":true,"story_case_ids":{"cib_burma_extra":["narrative_cib_revision_ac4fb499beb4b345b5384ae6"],"cib_salvador_bench":["narrative_cib_revision_ab8506d47badd3718e892a7e","narrative_cib_alt_h_3af565c9ad6e532e16c9264b","narrative_cib_revision_50e63144067940b5debe3fea"]},"version":"narrative-story-attempts/1"},"public_display_projection":{"native_outputs_modified":false,"omitted_initial_fields":["decision_summary_by_arm","reference_answer","showcase_review"],"reason":"Source judgments and fills are loaded with the explicitly opened saved result; release reviews remain in the private exact-source publication."},"public_transport":"public-narrative-replays/1","qualified_narratives":[{"case_ids":["narrative_cib_revision_ab8506d47badd3718e892a7e","narrative_cib_alt_h_3af565c9ad6e532e16c9264b","narrative_cib_revision_50e63144067940b5debe3fea"],"collection":"bench","corpus":"cib","narrative_id":"cib_salvador_bench"}],"qualified_release_ready":true,"quality_blockers":[],"release_scope":"qualified","run_id":"narrative_publication_23096e5d82521cab0ce33877","seal_scope":"PUBLIC_PRESENTATION_EXPORT_ONLY","selection_rule":"One executed starter and distinct bench per corpus/task; outcome-informed showcase","sha256":"2c987e16e241586834190bd65a626cca28291def50fc689d73a29ac668a67e66","showcase_ready":false,"source_report_ref":{"path":"experiments/narrative_demo/publication/narrative_publication_23096e5d82521cab0ce33877/report.json","sha256":"6fa944dc415f546556861bb891d4a29f61527a73597bcbdbb6c45d6784a8d49f"},"source_report_sha256":"d0642b7dc55925a0f891d70cb4beabc3fc214760c801b4777b99a998741ddcbe","static_replay":true,"status":"PARTIAL","version":"narrative-workbench-publication/1"}