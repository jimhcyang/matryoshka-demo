{"cases":[{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/narrative_cib_revision_ac39b62cbc7070a340c5d62d/native.json.gz","sha256":"57ca4ae9ca9722ab5809ac2e80fd76b90307dd32c036e0d02744975abcd4f763"},"native_checksum":"f7328bf6ea64471322e068ff6ad555bb1e9d3e11a2ecfa5942dd4a7dd3a5f43a","readings":[{"candidates":[],"reading_id":"next_reading_d05a2b3d020d8f566482c1e9"},{"candidates":[{"fill":"like Arias","rank":1,"status":"exploratory_contextual"},{"fill":"like First Vice President Diaz","rank":2,"status":"exploratory_contextual"},{"fill":"like former President Harmodio Arias","rank":3,"status":"exploratory_contextual"},{"fill":"like President Arias","rank":4,"status":"exploratory_contextual"},{"fill":"like Justice Remon","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_1a005fb20ea90c8bede96ba7"},{"candidates":[{"fill":"in Panama,","rank":1,"status":"exploratory_contextual"},{"fill":"to Panamanian President Increases","rank":2,"status":"exploratory_contextual"},{"fill":"in Panama","rank":3,"status":"exploratory_contextual"},{"fill":"of individuals","rank":4,"status":"exploratory_contextual"},{"fill":"against all potential opposition leaders","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_fa2b9f6ac0c608a3525d0515"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"narrative_cib_revision_ac39b62cbc7070a340c5d62d","corpus":"cib","date":"1958-05-23","document_id":"CIA-RDP79T00975A003700200001-8","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/narrative_cib_revision_ac39b62cbc7070a340c5d62d/origin_masked.json.gz","sha256":"2530a02b01f08ea34a2d66691d1a376ddeca4fc7657977c25c541194aa169786"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/narrative_cib_revision_ac39b62cbc7070a340c5d62d/origin_revealed.json.gz","sha256":"1593dceecf2db81a80b1af8db7834aaba022c3a8251612c5cb1f018164751a15"}},"query":"The 22 May riots in Panama against President de la Guardia's administration have led him to declare a state of siege and may erupt into full-scale revolution. The strong national guard, whose repression of student demonstrations earlier this week resulted in one death and widespread and violent resentment, has announced that it is slowly re-gaining control of Panama City. The guard has orders to kill. The students have been joined in a general strike against the government by labor unions and other groups, but appear to have lost control of the disturbance to hoodlums. The latter are probably incited by powerful opposition politicians [REDACTION] who are trying to oust the President. Similar riots are occurring in Colon, the northern terminus of the canal.","query_utf8_sha256":"43ad9d3a64bee57cfa5e23769dc476653658ca053096a1ec2602c0296052c6bf","task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/narrative_cib_revision_3eea5176c0eab4abfb6452a4/native.json.gz","sha256":"82890e3754b4305065f73eecf346d4ee4702b0638a1ca19bd155730fd5350fb5"},"native_checksum":"cc7872f7595ab4b454859df357f33482dc956b7657f8402971d629dc1766242f","readings":[{"candidates":[{"fill":"the air force commander","rank":1,"status":"exploratory_contextual"},{"fill":"the military","rank":2,"status":"exploratory_contextual"}],"reading_id":"next_reading_31ff17e95b0c05ea69654db3"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"narrative_cib_revision_3eea5176c0eab4abfb6452a4","corpus":"cib","date":"1961-03-29","document_id":"CIA-RDP79T00975A005600250001-2","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/narrative_cib_revision_3eea5176c0eab4abfb6452a4/origin_masked.json.gz","sha256":"3c2b344521ab302e974e84e2358b3750734a31145a724f2072e9b4ea03890ac5"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/narrative_cib_revision_3eea5176c0eab4abfb6452a4/origin_revealed.json.gz","sha256":"8c44f6c5d3497d4cec938d3c0baf399b7118fee37f516921f172f948871f3eac"}},"query":"The government's subsequent mistrust of officers who did not give all-out support to Diem has also had an unsettling effect. Diem's foot-dragging in carrying out a promised government reorganization prompted [REDACTION] to express doubt that Diem intended to do more than replace one group of \"yes men\" with another; a similar complaint was made recently by [MASKED].","query_utf8_sha256":"0838b8c56ce7789eb956bd83398fde211e6be37672ec945674d22b75c1394fef","task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/cloze_132dbc991d56c1c3ff66331a/native.json.gz","sha256":"c80da11a300b809f9cb0d144f5495847cee33d49d861a0011e46cef69de88107"},"native_checksum":"da7baeea071540400f46981454cd03afaa60d2c0ed305a206c7ec775b3d5de4f","readings":[{"candidates":[{"fill":"and Betancourt","rank":1,"status":"exploratory_contextual"},{"fill":"and Dominican dictator Trujillo","rank":2,"status":"exploratory_contextual"},{"fill":"and Daniel Fignol\u00e9","rank":3,"status":"exploratory_contextual"},{"fill":"and Rafael Somarriba","rank":4,"status":"exploratory_contextual"},{"fill":"and Provisional President Urrutia","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_81479663ec4b40f19fa30fdf"},{"candidates":[{"fill":"of the efforts to overthrow the regime of President Arbenz of Guatemala","rank":1,"status":"exploratory_contextual"},{"fill":"in Cuba","rank":2,"status":"exploratory_contextual"},{"fill":"of the Nicaraguan national guard","rank":3,"status":"exploratory_contextual"},{"fill":"in Havana","rank":4,"status":"exploratory_contextual"},{"fill":"in Managua","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_b65ff678cbd646fa5e2147ef"},{"candidates":[],"reading_id":"next_reading_36678042d2f4e8631eedd462"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"cloze_132dbc991d56c1c3ff66331a","corpus":"cib","date":"1959-06-27","document_id":"CIA-RDP79T00975A004500410001-6","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_132dbc991d56c1c3ff66331a/origin_masked.json.gz","sha256":"c983003a5062c830059fb8dbce080e66f29052476d6ba7227613a8feb9035f28"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_132dbc991d56c1c3ff66331a/origin_revealed.json.gz","sha256":"a4fc112a77b0ceadb5fa7601825b0376f729a2c5b9bb1229fae20a73ef8401cb"}},"query":"The Caribbean Crisis\n\nThe determination of leftists and liberals led by the Fidel Castro government of Cuba [REDACTION 1] to overthrow the Trujillo dictatorship in the Dominican Republic and the Somoza regime in Nicaragua has brought the contenders close to war. The situation also seriously threatens other governments, particularly the weak unpopular regime in Haiti. Military action has thus far been confined to rebel incursions into Nicaragua and the Dominican Republic, but may extend to counteraction by the beleaguered regimes against governments supporting the insurgents. Generalissimo Trujillo told the American ambassador on 20 June that \"defensive military action\" against Cuba will become \"imperative\" in the event of further insurgent landings. The armed forces chief of Nicaragua has also considered action against the hostile governments.\n\nLatin American Communists, who are particularly influential among the Cuban-backed rebel groups, would probably win influence in any postrevolutionary governments.","query_utf8_sha256":"3709f2c0989d1c20a64c626b21484be707327c9831e36b1909c61366bf63ce28","task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/cloze_225a750400eb38718fa5bb9b/native.json.gz","sha256":"756ea951d65037096bea5b1ed748d5723534684b5abae0e4b2e344b82b493d7e"},"native_checksum":"711694b529856368b1135f61aa0f41b35f44278f87649e0aa938929969f43b7d","readings":[{"candidates":[],"reading_id":"next_reading_aa7f5df05a5d114dfab067e6"},{"candidates":[{"fill":"corrupt","rank":1,"status":"exploratory_contextual"},{"fill":"Panamanian","rank":2,"status":"exploratory_contextual"},{"fill":"American","rank":3,"status":"exploratory_contextual"},{"fill":"exploited","rank":4,"status":"exploratory_contextual"},{"fill":"nationalist","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_0a6efaba6c01d35e92165159"},{"candidates":[],"reading_id":"next_reading_509c4499ef4d1596e833f8a2"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"cloze_225a750400eb38718fa5bb9b","corpus":"cib","date":"1959-11-04","document_id":"CIA-RDP79T00975A004800030001-5","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_225a750400eb38718fa5bb9b/origin_masked.json.gz","sha256":"2ab8ea5a42e9ffb8d571cb2134e8b0c2b20fdd9bf349e60cd47216d48dd18350"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_225a750400eb38718fa5bb9b/origin_revealed.json.gz","sha256":"a56b5ed7231aeab3b2f40eeeccb517014e6ebbefff1afedba7fde50afeeb9233"}},"query":"LATE ITEM\n\n*Panama: Further anti-American rioting and attempted incursions into the Canal Zone may follow yesterday's outbreaks. The wounding of several Panamanians by US troops, who defended Canal Zone entrances when the Panamanian National Guard failed to do so, may serve as a pretext for extremists to provoke additional disorder during the next few days. Panamanian grievances against the American administration of the Canal Zone are being exploited by nationalist politicians maneuvering in anticipation of next May's presidential election. The [REDACTION 1] ruling oligarchy in Panama appears willing to use anti-American sentiment regarding the Canal Zone in order to divert attention from the underlying social discontent of the lower income groups.[REDACTION]","query_utf8_sha256":"49f7da832730bf1f5a9a68904783cb7b140597a68c75cb9b3b4304e70714a36d","task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/release_controls_v1/showcase_cib_h_taiwan_talks_conditional_results_v2/native.json.gz","sha256":"b86d448546f8a7121cee16234a179e26f23196797655976bf27d906b596bc9c8"},"native_checksum":"5331df91e9e9487cdd35529d3d64f8481d573b471200103613815582f863d574","readings":[],"status":"SUPPORTED"}],"case_id":"showcase_cib_h_taiwan_talks_conditional_results_v2","corpus":"cib","date":"1958-09-13","document_id":"CIA-RDP79T00975A004000020001-4","origin_refs":{"masked":{"path":"phase/source_showcase_20261125/origin_entries/release_controls_v1/showcase_cib_h_taiwan_talks_conditional_results_v2/origins/showcase_cib_h_taiwan_talks_conditional_results_v2/masked.json.gz","sha256":"410c4df9437e0bc11075cf945100e1e9e0028570717396cf4c47c3a8237571d3"}},"query":"The Sino-American talks might lead to some results provided there was sincerity on both sides.","query_utf8_sha256":"31a3f1194898f1f1b5681b3a2c87e7a322691f38884cca4e8516ad6bcfd79f5c","task":"hypothesis"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/release_outer_v1/showcase_cib_m_soviet_announced_reductions_v2/native.json.gz","sha256":"ceaa8b8fab48d070fae11ec114605278c4480a21eea6967f3675e8ed7be7bed3"},"native_checksum":"f78e83b1efd8aed19a9370df9507b50a4e2effcb9dd0403e0f021f3c13d4840b","readings":[],"status":"EVIDENCE_BACKED_RECONSTRUCTION"}],"case_id":"showcase_cib_m_soviet_announced_reductions_v2","corpus":"cib","date":"1958-03-29","document_id":"CIA-RDP79T00975A003600250001-4","origin_refs":{"masked":{"path":"phase/source_showcase_20261125/origin_entries/release_outer_v1/showcase_cib_m_soviet_announced_reductions_v2/origins/showcase_cib_m_soviet_announced_reductions_v2/masked.json.gz","sha256":"4756d283125c2c91599b3967db43b2cc5c6ada90008921a867b65cfa5c170c19"}},"query":