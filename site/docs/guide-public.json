e_checksum":"da7baeea071540400f46981454cd03afaa60d2c0ed305a206c7ec775b3d5de4f","readings":[{"candidates":[{"fill":"and Betancourt","rank":1,"status":"exploratory_contextual"},{"fill":"and Dominican dictator Trujillo","rank":2,"status":"exploratory_contextual"},{"fill":"and Daniel Fignol\u00e9","rank":3,"status":"exploratory_contextual"},{"fill":"and Rafael Somarriba","rank":4,"status":"exploratory_contextual"},{"fill":"and Provisional President Urrutia","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_81479663ec4b40f19fa30fdf"},{"candidates":[{"fill":"of the efforts to overthrow the regime of President Arbenz of Guatemala","rank":1,"status":"exploratory_contextual"},{"fill":"in Cuba","rank":2,"status":"exploratory_contextual"},{"fill":"of the Nicaraguan national guard","rank":3,"status":"exploratory_contextual"},{"fill":"in Havana","rank":4,"status":"exploratory_contextual"},{"fill":"in Managua","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_b65ff678cbd646fa5e2147ef"},{"candidates":[],"reading_id":"next_reading_36678042d2f4e8631eedd462"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"cloze_132dbc991d56c1c3ff66331a","corpus":"cib","date":"1959-06-27","document_id":"CIA-RDP79T00975A004500410001-6","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_132dbc991d56c1c3ff66331a/origin_masked.json.gz","sha256":"c983003a5062c830059fb8dbce080e66f29052476d6ba7227613a8feb9035f28"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_132dbc991d56c1c3ff66331a/origin_revealed.json.gz","sha256":"a4fc112a77b0ceadb5fa7601825b0376f729a2c5b9bb1229fae20a73ef8401cb"}},"query":"The Caribbean Crisis\n\nThe determination of leftists and liberals led by the Fidel Castro government of Cuba [REDACTION 1] to overthrow the Trujillo dictatorship in the Dominican Republic and the Somoza regime in Nicaragua has brought the contenders close to war. The situation also seriously threatens other governments, particularly the weak unpopular regime in Haiti. Military action has thus far been confined to rebel incursions into Nicaragua and the Dominican Republic, but may extend to counteraction by the beleaguered regimes against governments supporting the insurgents. Generalissimo Trujillo told the American ambassador on 20 June that \"defensive military action\" against Cuba will become \"imperative\" in the event of further insurgent landings. The armed forces chief of Nicaragua has also considered action against the hostile governments.\n\nLatin American Communists, who are particularly influential among the Cuban-backed rebel groups, would probably win influence in any postrevolutionary governments.","query_utf8_sha256":"3709f2c0989d1c20a64c626b21484be707327c9831e36b1909c61366bf63ce28","source_assessment":null,"task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/cloze_225a750400eb38718fa5bb9b/native.json.gz","sha256":"756ea951d65037096bea5b1ed748d5723534684b5abae0e4b2e344b82b493d7e"},"native_checksum":"711694b529856368b1135f61aa0f41b35f44278f87649e0aa938929969f43b7d","readings":[{"candidates":[],"reading_id":"next_reading_aa7f5df05a5d114dfab067e6"},{"candidates":[{"fill":"corrupt","rank":1,"status":"exploratory_contextual"},{"fill":"Panamanian","rank":2,"status":"exploratory_contextual"},{"fill":"American","rank":3,"status":"exploratory_contextual"},{"fill":"exploited","rank":4,"status":"exploratory_contextual"},{"fill":"nationalist","rank":5,"status":"exploratory_contextual"}],"reading_id":"next_reading_0a6efaba6c01d35e92165159"},{"candidates":[],"reading_id":"next_reading_509c4499ef4d1596e833f8a2"}],"status":"CANDIDATE_SUGGESTIONS"}],"case_id":"cloze_225a750400eb38718fa5bb9b","corpus":"cib","date":"1959-11-04","document_id":"CIA-RDP79T00975A004800030001-5","origin_refs":{"masked":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_225a750400eb38718fa5bb9b/origin_masked.json.gz","sha256":"2ab8ea5a42e9ffb8d571cb2134e8b0c2b20fdd9bf349e60cd47216d48dd18350"},"revealed":{"path":"experiments/full_resume_20261120/publication_preview_v01/cases/cloze_225a750400eb38718fa5bb9b/origin_revealed.json.gz","sha256":"a56b5ed7231aeab3b2f40eeeccb517014e6ebbefff1afedba7fde50afeeb9233"}},"query":"LATE ITEM\n\n*Panama: Further anti-American rioting and attempted incursions into the Canal Zone may follow yesterday's outbreaks. The wounding of several Panamanians by US troops, who defended Canal Zone entrances when the Panamanian National Guard failed to do so, may serve as a pretext for extremists to provoke additional disorder during the next few days. Panamanian grievances against the American administration of the Canal Zone are being exploited by nationalist politicians maneuvering in anticipation of next May's presidential election. The [REDACTION 1] ruling oligarchy in Panama appears willing to use anti-American sentiment regarding the Canal Zone in order to divert attention from the underlying social discontent of the lower income groups.[REDACTION]","query_utf8_sha256":"49f7da832730bf1f5a9a68904783cb7b140597a68c75cb9b3b4304e70714a36d","source_assessment":null,"task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/demo_refinement_20261126/epochs/cib_h_nuclear_native_v1/refine_cib_h_independent_nuclear_security_v1/native.json.gz","sha256":"9abeeef34a5d188ee1eb9c873a6e95bcceea77b90d2c0b791fd7f3159973f44e"},"native_checksum":"998b1f4802063c1350e57bd974463e5c639be26767bc617d65dde57d0fbeff98","readings":[],"status":"UNRESOLVED"}],"case_id":"refine_cib_h_independent_nuclear_security_v1","corpus":"cib","date":"1960-03-11","document_id":"CIA-RDP79T00975A005000100001-4","origin_refs":{"masked":{"path":"phase/demo_refinement_20261126/origin_entries/cib_nuclear_h_native_v1/refine_cib_h_independent_nuclear_security_v1/masked.json","sha256":"c7350072d0673d675e54