z","sha256":"f58f8e2ebf4e7e1286d25e84733586af967aafbd1133df07a9f8c3bdae7e78a1"}},"query":"The armed forces, which had been virtually paralyzed by disunity, appear to have been spurred to cooperation by increasingly bold Communist activity in recent weeks. Unrestricted Communist organizational activity among the [REDACTION] Salvadoran peasants and the visit to Cuba earlier this month of a group of Salvadoran extremists have particularly heightened the concern of the military.","query_utf8_sha256":"25efa075c9a410c0cc6b4480f550d426d517083a4bcf39e8ab036087bbbd92f0","task":"redaction"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/final_showcase_v2/showcase_iran_h_shah_retained_command_v6/native.json.gz","sha256":"ab2212dfa6440778129c6b2159df4c344bb8e7be681c9d05a5b064f0ed75b213"},"native_checksum":"6019fc74ffab2f1758dbfd352915543e27874edbd3218149f9dc8ba7d1f99e70","readings":[],"status":"PARTIAL_CONTEXT"}],"case_id":"showcase_iran_h_shah_retained_command_v6","corpus":"iran","date":"1978-12-18","document_id":"1978TEHRAN12348","origin_refs":{"masked":{"path":"phase/source_showcase_20261125/origin_entries/final_showcase_v2/showcase_iran_h_shah_retained_command_v6/origins/showcase_iran_h_shah_retained_command_v6/masked.json.gz","sha256":"54b3d4d1dc203b9c2edda627353b5853a4c92aba011345b7e453d1dded5af707"}},"query":"Under the proposed constitutional arrangement, the Shah would remain commander-in-chief of the armed forces.","query_utf8_sha256":"f23f5ead49ad2d1c1f2398da8df6ba5d9c448724a396cb98066afad5ff2403f5","task":"hypothesis"},{"assessments":[{"config":"llm_readings","native_checkpoint":{"path":"phase/source_showcase_20261125/epochs/release_outer_v1/showcase_iran_m_tehrani_direct_v2/native.json.gz","sha256":"0a8c8f50ac3a020030c71274d79ec3bbdf8995c5c5b574404bc27a8ec8e8ee49"},"native_checksum":"93d279d590818f73b74eae911718fd3b18bbfd059e535e59b8dc205128819957","readings":[],"status":"EVIDENCE_BACKED_RECONSTRUCTION"}],